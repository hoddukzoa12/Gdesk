{
  "name": "gdesk",
  "productName": "Gdesk",
  "version": "0.1.0",
  "private": true,
  "description": "오픈소스 메인테이너를 위한 GitHub 현황판 데스크톱 앱",
  "license": "MIT",
  "author": "hoddukzoa",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "cross-env GDESK_TEST_BUILD=1 electron-vite build && playwright test --pass-with-no-tests",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "clsx": "^2.1.1",
    "dugite": "^3.2.3",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.5",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "dugite",
      "electron",
      "esbuild"
    ]
  }
}
